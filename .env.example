# ============================================================
# DokterKlik — Environment Variables Template
# Copy to .env and fill in all values before running
# NEVER commit .env to version control
# ============================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-very-secret-key-change-this-in-production-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-key-here

# Database
DATABASE_URL=postgres://dokterklik:dokterklik@db:5432/dokterklik
POSTGRES_DB=dokterklik
POSTGRES_USER=dokterklik
POSTGRES_PASSWORD=dokterklik

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible file storage)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=dokterklik
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_STORAGE_BUCKET_NAME=dokterklik
AWS_S3_ENDPOINT_URL=http://minio:9000

# SATUSEHAT (https://api-satusehat-stg.dto.kemkes.go.id for staging)
SATUSEHAT_BASE_URL=https://api-satusehat-stg.dto.kemkes.go.id
# Per-clinic credentials stored encrypted in DB; these are defaults for testing
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=

# WhatsApp (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_ENABLED=False

# Midtrans
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_SANDBOX=True

# Email (development: console; production: SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@dokterklik.id
